{
  "compilerOptions": {
    "target": "ES2022",
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "module": "ESNext",
    "types": [
      "vite/client"
    ],
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "moduleDetection": "force",
    "allowJs": true,
    "jsx": "react-jsx",
    "paths": {
      "@/*": [
        "./*"
      ]
    },
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "exclude": [
    "node_modules",
    "dist",
    "artifacts/**",
    "attached_assets/**",
    "Solvex-core/**",
    "lib/**",
    "scripts/src/**",
    "src/converted_app/**"
  ],
  "include": [
    "src/main.tsx",
    "server.ts",
    "vite.config.ts",
    "scripts/verify_120_aggregation.ts",
    "scripts/test_formal_evidence_hash.ts"
  ]
}
