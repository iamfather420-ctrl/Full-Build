# SOLVEX server runtime configuration. Never expose any secret through Vite variables.
NODE_ENV="development"
SOLVEX_ENVIRONMENT="local" # local | sandbox | production
SOLVEX_ENV="local" # legacy alias accepted only for compatibility
SOLVEX_DB_PATH=".sovereign_data/solvex.sqlite" # local/sandbox evidence only; never authoritative production persistence

# Application authentication and encryption. Use managed secrets in production.
SOLVEX_AUTH_SECRET=""
SOLVEX_SESSION_SECRET=""
SOLVEX_ENCRYPTION_KEY=""

# PayPal server-only credentials. Configure exactly one environment-specific set.
PAYPAL_ENVIRONMENT="sandbox" # sandbox | live
PAYPAL_LIVE_CLIENT_ID=""
PAYPAL_LIVE_CLIENT_SECRET=""
PAYPAL_SANDBOX_CLIENT_ID=""
PAYPAL_SANDBOX_CLIENT_SECRET=""
PAYPAL_WEBHOOK_ID=""
PAYPAL_WEBHOOK_SECRET=""
PAYPAL_RETURN_URL=""
PAYPAL_CANCEL_URL=""

# PYUSD requires explicit provider-issued asset evidence; configuration alone is insufficient.
PYUSD_PROVIDER=""
PYUSD_NETWORK=""
PYUSD_ASSET_IDENTIFIER=""
PAYPAL_PYUSD_ONLY_ENABLED="false"

# Production database. DATABASE_URL is canonical; NEON_DATABASE_URL is retained for compatibility.
DATABASE_URL=""
DATABASE_DIRECT_URL=""
NEON_DATABASE_URL=""

# Production identity provider.
PRODUCTION_IDP_ISSUER=""
PRODUCTION_IDP_CLIENT_ID=""
PRODUCTION_IDP_CLIENT_SECRET=""

# Audit/infrastructure managed secrets.
AUDIT_SIGNING_KEY=""
AUDIT_ENCRYPTION_KEY=""

# Production deployment identity.
SOLVEX_BASE_URL=""
