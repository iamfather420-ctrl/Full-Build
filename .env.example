# Runtime environment
NODE_ENV=development
PORT=3000

# Local HS256 is for development/test only; never use it in production.
AUTH_MODE=local_hs256
SOVEREIGN_AUTH_SECRET=

# Production trusted OIDC configuration (replace with your real provider values).
# Production readiness requires AUTH_MODE=oidc and HTTPS issuer/JWKS URLs.
# AUTH_MODE=oidc
# AUTH_ISSUER=https://your-identity-provider.example/
# AUTH_AUDIENCE=solvex-daisy-haminja
# AUTH_JWKS_URL=https://your-identity-provider.example/.well-known/jwks.json
# AUTH_MAX_TOKEN_LIFETIME_SECONDS=3600

# Existing Neon PostgreSQL database. Readiness checks are read-only.
NEON_DATABASE_URL=
SOLVEX_ENV=development
# Intentionally no PayPal credentials or payment configuration: payments are disabled.
# Do not set ALLOW_NEON_SCHEMA_MIGRATIONS in production.
# Required for the built-in OIDC authorization-code + PKCE flow in production.
# AUTH_CLIENT_ID=replace-with-registered-client-id
# AUTH_CLIENT_SECRET=replace-with-secret-manager-reference-value
# AUTH_REDIRECT_URI=https://your-app.example/auth/callback
# Set true only for a deliberately single-replica deployment; login state is in process memory.
# OIDC_SINGLE_REPLICA_MODE=true

# Optional model key used by Gemini-backed routes.
GEMINI_API_KEY=

# Public URL of this deployment.
APP_URL=
