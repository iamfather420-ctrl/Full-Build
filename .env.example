# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# PAYPAL CREDENTIALS (DN-35 Enterprise Payment Gateway)
# Sandbox credentials
PAYPAL_SANDBOX_CLIENT_ID=""
PAYPAL_SANDBOX_CLIENT_SECRET=""

# Live / Production credentials
PAYPAL_LIVE_CLIENT_ID=""
PAYPAL_LIVE_CLIENT_SECRET=""

PAYPAL_ACTIVE_ENVIRONMENT="sandbox" # "sandbox" or "live"
PAYPAL_WEBHOOK_ID=""

# NEON SERVERLESS POSTGRESQL (DN-34 Adapter)
# Optional: Database URL for serverless sync; fallback is local multi-tenant SQLite
NEON_DATABASE_URL=""
