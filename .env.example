# Runtime environment
NODE_ENV=development
PORT=8080

# Production proof API identity: configure these with your trusted OIDC provider.
# Tokens must be RS256-signed and contain sub, email, tenant_id, role, iss, aud, iat, exp.
AUTH_ISSUER=
AUTH_AUDIENCE=solvex-daisy-haminja
AUTH_JWKS_URL=
AUTH_MAX_TOKEN_LIFETIME_SECONDS=3600

# Durable Neon S3-compatible proof storage. Server-side only; never expose to browser.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=us-east-2
SOLVEX_PROOF_BUCKET=solvex-proofs
SOLVEX_PROOF_HMAC_KEY=

# Existing Neon PostgreSQL database. Readiness checks are read-only.
NEON_DATABASE_URL=
SOLVEX_ENV=development
# Intentionally no payment configuration: payments are disabled.
PAYMENTS_ENABLED=false

# Optional model key used by Gemini-backed routes.
GEMINI_API_KEY=
APP_URL=
