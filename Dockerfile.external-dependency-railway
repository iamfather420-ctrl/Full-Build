FROM oven/bun:1.3.14-slim
RUN apt-get update -qq && apt-get install --no-install-recommends -y postgresql-client ca-certificates && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY . .
# The repository's bun.lock is npm-format; resolve dependencies from package.json as the main Dockerfile does.
RUN rm -f bun.lock && bun install
ENV NODE_ENV=production
ENV PORT=8080
EXPOSE 8080
CMD ["bun", "run", "external-dependency-railway"]
