# Daisy uses only local inference. No remote AI provider or fallback is configured.
# The registered Qwen3 GGUF defaults to daisy-ai-os/models/Qwen3-1.7B-Q4_K_M.gguf.
DAISY_MODEL_ID=qwen3-1.7b-instruct-q4_k_m
DAISY_MODEL_VERSION=Qwen3-1.7B-Q4_K_M
# Optional override; omit to use the registered default model file path.
# DAISY_MODEL_PATH=/absolute/path/to/Qwen3-1.7B-Q4_K_M.gguf
# Required for chat; install/build llama.cpp b5092 or newer and use its absolute executable path.
DAISY_INFERENCE_ENGINE=/absolute/path/to/llama-cli
DAISY_SYSTEM_PROMPT=
DAISY_ACTIVATION_EVIDENCE_PATH=/absolute/path/to/daisy-brain-activation-gate.json

# Optional secret for human-signed native tool authorizations (minimum 32 characters).
# Generate and store a real secret outside version control; never commit it here.
DAISY_OS_PERMISSION_SECRET=

# Optional. Defaults to 3090. Server always binds to 127.0.0.1.
PORT=3090
