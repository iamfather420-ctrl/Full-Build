{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Daisy verified conversational training record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "recordId",
    "split",
    "messages",
    "sourceId",
    "sourceSha256",
    "evidenceRefs",
    "verification",
    "licenseStatus",
    "trainingEligible"
  ],
  "properties": {
    "recordId": {"type": "string", "minLength": 1},
    "split": {"enum": ["train", "validation"]},
    "messages": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "content"],
        "properties": {
          "role": {"enum": ["system", "user", "assistant"]},
          "content": {"type": "string", "minLength": 1}
        }
      }
    },
    "sourceId": {"type": "string", "minLength": 1},
    "sourceSha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
    "evidenceRefs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "verification": {"const": "VERIFIED"},
    "licenseStatus": {"const": "APPROVED"},
    "trainingEligible": {"const": true}
  }
}
